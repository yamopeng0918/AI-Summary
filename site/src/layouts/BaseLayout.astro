---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AI Digest 的公開內容摘要" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell">
        <a class="site-name" href="/">AI Digest</a>
        <p>公開內容摘要</p>
      </div>
    </header>
    <main class="site-main site-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-shell">AI Digest · 靜態摘要網站</div>
    </footer>
  </body>
</html>
